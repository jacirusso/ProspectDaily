# Copy to .env and fill in. The engine runs with NONE of these set (mock mode).

# --- Data provider ---
# mock = fake data for testing (default). apollo = real prospects.
DATA_PROVIDER=mock
APOLLO_API_KEY=
APOLLO_REVEAL_CONTACTS=true

# --- AI copywriting (fit note + intro email) ---
# Without this, a solid template is used instead of Claude.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Google Drive delivery ---
# Either the absolute path to the service-account .json, or the JSON contents.
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Database ---
# Leave blank for local SQLite. In production set a Postgres URL.
DATABASE_URL=

# --- Billing (web app) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_10=       # Stripe price id for the "10 prospects/day" plan
STRIPE_PRICE_20=
STRIPE_PRICE_30=
STRIPE_PRICE_40=
STRIPE_PRICE_50=
STRIPE_PRICE_100=

# --- App ---
APP_SECRET_KEY=change-me-to-a-long-random-string
APP_BASE_URL=http://localhost:8000
